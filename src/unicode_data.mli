(** Unicode tables generated by [scripts/gen-unicode-tables.py]. Internal; use
    {!Unicode_fold}. *)

(** The Unicode version the tables were generated from. *)
val unicode_version : string

(** Code points with a compatibility decomposition, ascending. *)
val decomp_keys : int array

(** [decomp_offsets.(i)] to [decomp_offsets.(i + 1)] index the decomposition of
    [decomp_keys.(i)] in {!decomp_values}. *)
val decomp_offsets : int array

(** Concatenated full NFKD decompositions. *)
val decomp_values : int array

(** Inclusive ranges of combining marks as consecutive pairs, ascending. *)
val mark_ranges : int array

(** Code points with a one-code-point lowercase, ascending. *)
val lower_keys : int array

(** The lowercase of [lower_keys.(i)]. *)
val lower_values : int array
